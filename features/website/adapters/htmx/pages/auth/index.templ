package auth

import "fmt"

templ index() {
	<!DOCTYPE html>
	<html>
		<head>
			<link
				rel="stylesheet"
				href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.8/dist/flatly/bootstrap.min.css"
				integrity="sha384-MZ3pnZEBOL1wAG2nrP+M1A9LCApF229c39UC+1T3B96aI3VjuAWMeb1I99GMJacE"
				crossorigin="anonymous"
			/>
			<script
				src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
				integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
				crossorigin="anonymous"
				defer
			></script>
			<script
				src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"
				integrity="sha384-/TgkGk7p307TH7EXJDuUlgG3Ce1UVolAOFopFekQkkXihi5u/6OCvVKyz1W+idaz"
				crossorigin="anonymous"
			></script>
		</head>
		<body>
			<div id="niltarget" style="display: none;"></div>
			<div class="d-flex flex-row justify-content-center align-items-center vh-100">
				<div id="main-contents" class="w-25 border p-5 rounded">
					@SignRegBlock(true, false)
					<hr/>
					<form>
						<div id="username-container" class="form-floating mb-3">
							<input type="text" class="form-control" id="usernameInput" placeholder="" name="username"/>
							<label for="usernameInput">Имя пользователя </label>
						</div>
						<div id="password-container" class="form-floating">
							<input type="password" class="form-control" id="passwordInput" placeholder="" autocomplete="off" name="password"/>
							<label for="passwordInput">Пароль</label>
						</div>
						<button hx-target="#niltarget" id="submitbutton" type="submit" class="btn btn-primary btn-block mt-4 w-100" hx-post="/auth">Войти</button>
					</form>
				</div>
			</div>
		</body>
	</html>
}

templ accountRedirect() {
	<div hx-swap-oob="outerHTML" id="main-contents" class="w-25 p-5 rounded">
		<a href="/accounts">
			<button class="btn btn-success w-100"><h5 class="mb-0">Перейти к счетам </h5> </button>
		</a>
	</div>
}

templ usernameContainerError(input string, issue string) {
	<div hx-swap-oob="outerHTML" id="username-container" class="form-floating mb-3 has-danger">
		<input type="text" class="form-control is-invalid" id="usernameInput" placeholder="" value={ input } name="username"/>
		<label for="usernameInput">Имя пользователя </label>
		<div class="invalid-feedback">{ issue } </div>
	</div>
}

templ passwordContainerError(input string, issue string) {
	<div hx-swap-oob="outerHTML" id="password-container" class="form-floating has-danger">
		<input type="password" class="form-control is-invalid" id="passwordInput" placeholder="" autocomplete="off" value={ input } name="password"/>
		<label for="passwordInput">Пароль</label>
		<div class="invalid-feedback">{ issue } </div>
	</div>
}

templ SignRegBlock(isSign bool, swapSubmit bool) {
	{{
		signclass := "btn-primary"
		registerclass := "btn-outline-primary"

		if !isSign {
			signclass, registerclass = registerclass, signclass
		}
	}}
	// hx-target and hx-swap are inherited to the buttons
	<div
		id="signreg-div"
		hx-target="#signreg-div"
		hx-swap="outerHTML"
		class="btn-group w-100"
		role="group"
	>
		<button hx-get={ templ.URL("/auth/switch/signin") } class={ fmt.Sprintf("w-100 btn %s", signclass) }>
			<h5 class="mb-0">Вход</h5>
		</button>
		<button hx-get={ templ.URL("/auth/switch/register") } class={ fmt.Sprintf("w-100 btn %s", registerclass) }>
			<h5 class="mb-0">Регистрация</h5>
		</button>
	</div>
	// If it is not initial creation then swap existing button on the page
	if swapSubmit {
		{{
			target := "/auth"
			title := "Войти"
			if !isSign {
				target = "/register"
				title = "Зарегистрироваться"
			}
		}}
		<button
			hx-swap-oob="outerHTML"
			hx-target="#niltarget"
			id="submitbutton"
			type="submit"
			class="btn btn-primary btn-block mt-4 w-100"
			hx-post={ target }
		>{ title } </button>
	}
}
